# PostgreSQL container (docker compose)
POSTGRES_USER=codequest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codequest

# Application
DATABASE_URL=postgresql+psycopg://codequest:change-me@localhost:5432/codequest
TEST_DATABASE_URL=postgresql+psycopg://codequest:change-me@localhost:5432/codequest_test
FUNCTIONAL_DATABASE_URL=postgresql+psycopg://codequest:change-me@localhost:5432/codequest_functional
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=8
FRONTEND_ORIGIN=http://localhost:3000

# Hints
HINT_COOLDOWN_SECONDS=15

# Failed logins allowed per username and client address within the window
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# AI provider: fake | openai_compatible
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_REASONING_EFFORT=
FAKE_LLM_LOG=

# Read by `app.cli create-professor` and `app.cli seed-demo` when set (prompted otherwise)
CODEQUEST_PROFESSOR_PASSWORD=
