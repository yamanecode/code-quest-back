# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=dev                       # dev | test | prod
# Used by docker compose for the db service
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg2://codequest:CHANGE_ME@localhost:5432/codequest
# Optional; default derives <database>_test (codequest_test)
TEST_DATABASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000    # comma-separated
ENABLE_DOCS=                          # empty = true, except false in prod
PROFESSOR_INVITE_CODE=                # empty disables professor registration
APP_TIMEZONE=America/Sao_Paulo
REDIS_URL=                            # empty = in-memory rate limit and AI quota
LOG_LEVEL=INFO

# LLM / embeddings (phase 03+)
LLM_PROVIDER=fake                     # fake | gemini | openai_compatible
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
EMBEDDING_PROVIDER=                   # empty = LLM_PROVIDER
EMBEDDING_MODEL=
EMBEDDING_DIM=768
GEMINI_API_KEY=                       # deprecated, removed in phase 03

AI_DAILY_QUOTA_STUDENT=30
AI_DAILY_QUOTA_PROFESSOR=100
AI_FEEDBACK_ENABLED=true
AI_RUBRIC_EVALUATION_ENABLED=false
AGENT_MAX_ITERATIONS=2
AGENT_CRITIC_ENABLED=true
SURPRISE_BONUS_PROBABILITY=0.25
DEMO_PASSWORD=
